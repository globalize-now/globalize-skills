{
  "match": {
    "framework": "next",
    "router": "app",
    "compiler": "swc",
    "react": true,
    "vue": false,
    "typescript": true,
    "packageManager": "npm",
    "existing": {
      "library": "next-intl",
      "configured": true,
      "providerWired": true,
      "catalogsScaffolded": true,
      "stringsWrapped": "no",
      "present": true
    }
  },
  "ignore": [
    "candidateFiles",
    "routeEntries",
    "git",
    "localeSignals",
    "sourceDir",
    "existing.signals"
  ],
  "softAssert": {
    "candidateFilesMinCount": 1
  }
}
